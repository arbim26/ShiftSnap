<?xml version="1.0" encoding="utf-8"?>
<!--
    Tahap 2 – ShiftSnap
    activity_form_report.xml
    Form Laporan Shift Interaktif (ConstraintLayout + Material3)
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        tools:context=".FormReportActivity">

        <!-- ── TOOLBAR ──────────────────────────────────────────── -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_chevron_right"
            app:navigationContentDescription="Kembali"
            app:title="Laporan Shift"
            app:titleCentered="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ── SECTION: IDENTITAS ────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIdentitas"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Identitas Laporan"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp"/>

                <!-- Kode / Nama Mesin -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNamaMesin"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kode / Nama Mesin"
                    app:startIconDrawable="@drawable/ic_bar_chart"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNamaMesin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Spinner Shift -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilShift"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Pilihan Shift">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerShift"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── SECTION: STATUS MESIN UTAMA ───────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusMesin"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardIdentitas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status Mesin Utama"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvStatusError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih salah satu status"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/rgStatusMesin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbNormal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅  Normal / Siap Jalan"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:padding="8dp"/>

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbMaintenance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️  Perlu Maintenance"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:padding="8dp"/>

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbBreakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔴  Rusak / Breakdown"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:padding="8dp"/>

                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── SECTION: DAFTAR PERIKSA ────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChecklist"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardStatusMesin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Periksa Komponen"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPelumas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cek Pelumas / Oli"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:padding="8dp"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSuhu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cek Suhu Mesin"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:padding="8dp"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbKelistrikan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cek Modul Kelistrikan"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:padding="8dp"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbKebersihan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kebersihan Area Mesin"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:padding="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── SECTION: CATATAN KENDALA ───────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCatatan"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardChecklist"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan Kendala Teknis"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCatatan"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Deskripsikan kendala yang ditemukan…"
                    app:counterEnabled="true"
                    app:counterMaxLength="300"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCatatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:maxLines="6"
                        android:maxLength="300"
                        android:gravity="top|start"
                        android:scrollbars="vertical"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── SECTION: FOTO KONDISI MESIN ───────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFoto"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardCatatan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dokumentasi Foto"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp"/>

                <!-- Placeholder preview area -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- State: belum ada foto -->
                        <LinearLayout
                            android:id="@+id/layoutFotoEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_gravity="center">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_camera_machine"
                                app:tint="?attr/colorOnSurfaceVariant"
                                android:contentDescription="Ikon kamera"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Belum ada foto"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>

                        <!-- State: foto sudah terlampir (badge indikator) -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgFotoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="Preview foto kondisi mesin"/>

                        <!-- Badge "Foto Terlampir" -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFotoAttached"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:text="📎 Foto Terlampir"
                            android:visibility="gone"/>

                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tombol Ambil Foto -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAmbilFoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ambil Foto Kondisi Mesin"
                    app:icon="@drawable/ic_camera_machine"
                    app:iconGravity="textStart"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── TOMBOL SIMPAN & LIHAT PRATINJAU ───────────────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="Simpan &amp; Lihat Pratinjau"
            android:textAllCaps="false"
            android:padding="14dp"
            app:icon="@drawable/ic_add_report"
            app:iconGravity="textStart"
            app:layout_constraintTop_toBottomOf="@id/cardFoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml – update Tahap 2: tambah FormReportActivity & ReportDetailActivity -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.shiftsnap">

    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_person"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_person"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShiftSnap">

        <!-- LoginActivity sebagai launcher -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.ShiftSnap.Login"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- TAHAP 2: Form input laporan shift -->
        <activity
            android:name=".FormReportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <!-- TAHAP 2: Halaman rekapitulasi / pratinjau laporan -->
        <activity
            android:name=".ReportDetailActivity"
            android:exported="false"
            android:parentActivityName=".FormReportActivity" />


        <!-- TAHAP 3: Rekapitulasi riwayat laporan -->
        <activity
            android:name=".RecapListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="Riwayat Laporan" />

        <!-- TAHAP 3: Detail satu laporan dari riwayat -->
        <activity
            android:name=".DetailReportActivity"
            android:exported="false"
            android:parentActivityName=".RecapListActivity"
            android:label="Detail Laporan" />

        <!-- FileProvider untuk berbagi URI foto kamera ke Intent -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.shiftsnap.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>
</manifest>
